# Public site URL (used for metadata, sitemap, and CORS origin checks)
NEXT_PUBLIC_SITE_URL=https://www.wandaaratours.com

# PostgreSQL connection string (Prisma). Use a local Postgres, or a hosted
# provider such as Neon or Supabase. Must include ?sslmode=require for most
# hosted providers.
DATABASE_URL=postgresql://user:password@localhost:5432/wandaara

# Secret used to sign admin session JWTs and password-reset tokens.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Seed-only: the first admin account created by `npm run db:seed`.
# Change this password immediately after first login — the seeded account
# is created with forcePasswordChange enabled.
ADMIN_SEED_EMAIL=admin@wandaaratours.com
ADMIN_SEED_PASSWORD=change-me-immediately

# Vercel Blob token for admin image uploads (destinations/packages/blog/testimonials).
# Without this set, the admin image-upload button is disabled and editors must
# paste an externally-hosted image URL instead.
BLOB_READ_WRITE_TOKEN=

# SMTP credentials for the inquiry form (e.g. SendGrid, Mailgun, AWS SES, Gmail SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Where inquiry form submissions are delivered, and the from-address used to send them
INQUIRY_TO_EMAIL=info@wandaaratours.com
INQUIRY_FROM_EMAIL=no-reply@wandaaratours.com

# Optional: hCaptcha/reCAPTCHA site + secret keys, if enabling CAPTCHA on top of the honeypot
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Optional: swap the in-memory rate limiter (lib/ratelimit.ts) for Upstash in multi-instance
# production deployments
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
